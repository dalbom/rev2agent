# Rev2Agent machine-local provider/model configuration
.rev2agent_config.json

# User research projects: every root-level directory that is not part of the
# framework is a project dir and stays untracked by default. Gitignore cannot
# condition on directory contents, so this is an allowlist of framework dirs.
/*/
!/prompts/
!/scripts/
!/tests/
!/.github/
!/assets/

# Avatar sources stay local: the sheets and 384 px tiles are regenerated from
# assets/avatars/PROMPTS.md. The repo keeps the prompts, the slicing script,
# the README preview, and the mod's own thumbnails under .claude/skills.
/assets/avatars/sheets/
/assets/avatars/*.png
!/assets/avatars/preview.png
/assets/avatars/manifest.json

# Claude Code: only the project's skills folder (the reviewer2 mod) is shared;
# settings.local.json and anything else under .claude/ stay machine-local.
!/.claude/
/.claude/*
!/.claude/skills/
# Type declarations the engine writes beside a loaded mod
/.claude/skills/*/.claude-plugin/types/

# Local documentation and internal development records
/docs/

# LaTeX compiler binary (users download it to the repo root)
/tectonic

# Compiled PDFs. Project dirs are already wholesale-ignored above; this rule
# remains as a backstop for stray PDFs at the repo root or inside framework
# dirs (e.g., test artifacts from manuscript compilation).
*.pdf

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
